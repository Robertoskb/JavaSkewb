<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1080.0" styleClass="main-background" stylesheets="@css/menu.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.javaskewb.Controller.MenuController">

    <children>
        <VBox alignment="CENTER" maxWidth="350.0" spacing="50.0">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label styleClass="title-label" text="JavaSkewb" />
                    <Label styleClass="subtitle-label" text="Versão de Testes" />
                </VBox>

                <VBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="btnLearn" maxWidth="Infinity" onAction="#toCases" styleClass="menu-button, primary-button" text="Aprender" />
                        <Button fx:id="btnTimer" maxWidth="Infinity" onAction="#toTimer" styleClass="menu-button, primary-button" text="Praticar" />
                        <Button fx:id="btnAbout" maxWidth="Infinity" onAction="#toAbout" styleClass="menu-button, secondary-button" text="Sobre" />
                    </children>
                </VBox>

                <Label styleClass="footer-label" text="Versão 1.1">
                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </children>

</StackPane>

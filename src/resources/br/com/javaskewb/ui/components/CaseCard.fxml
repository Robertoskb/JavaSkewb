<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root fx:id="root" style="-fx-background-color: transparent; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 10, 0, 0, 4);" type="VBox" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <StackPane style="-fx-background-color: #2C3E50; -fx-background-radius: 12 12 0 0;">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="caseNameLabel" text="Nome do Caso" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
        <StackPane fx:id="skewbContainer" style="-fx-background-color: #F9F4F4; -fx-background-radius: 0 0 12 12;" VBox.vgrow="ALWAYS">
            <children>
            </children>
        </StackPane>
    </children>

</fx:root>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="494.0"
            prefWidth="692.0"
            style="-fx-background-color: #F4F6F9;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.javaskewb.Controller.MainController">

    <left>
        <VBox prefHeight="494.0"
              prefWidth="170.0"
              style="-fx-background-color: #1E293B;
                     -fx-padding: 20;"
              BorderPane.alignment="CENTER"/>
    </left>

    <center>
        <VBox alignment="TOP_CENTER"
              prefHeight="434.0"
              prefWidth="530.0"
              spacing="20"
              style="-fx-padding: 25;">

            <children>

                <VBox prefHeight="20"/>

                <VBox fx:id="scrambleContainer"
                      alignment="CENTER"
                      prefHeight="70.0"
                      prefWidth="500.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #D6D9E0;
                             -fx-border-radius: 12;
                             -fx-padding: 15;">

                    <children>
                        <Text fx:id="scrambleText"
                              text="Scramble"
                              style="-fx-font-size: 18px;
                                     -fx-font-weight: bold;
                                     -fx-fill: #334155;"/>
                    </children>

                </VBox>

                <VBox fx:id="skewbContainer"
                      alignment="CENTER"
                      prefHeight="260.0"
                      prefWidth="320.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-border-color: #D6D9E0;
                             -fx-border-radius: 18;
                             -fx-padding: 20;"/>

            </children>

        </VBox>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- O VBox principal aplica a sombra e mantém o fundo transparente para não sobrepor os cantos -->
<fx:root fx:id="root" style="-fx-background-color: transparent; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 10, 0, 0, 4);"  type="VBox"
         xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <!-- Cabeçalho (Área reservada para o nome com cor diferente) -->
        <!-- Bordas arredondadas apenas no topo: 12 (esq) 12 (dir) 0 (dir-inf) 0 (esq-inf) -->
        <StackPane style="-fx-background-color: #2C3E50; -fx-background-radius: 12 12 0 0;">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="caseNameLabel" text="Nome do Caso" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </StackPane>

        <!-- Corpo (Área reservada para o componente Skewb) -->
        <!-- Bordas arredondadas apenas na base: 0 (esq-sup) 0 (dir-sup) 12 (dir-inf) 12 (esq-inf) -->
        <StackPane fx:id="skewbContainer" style="-fx-background-color: #F9F4F4; -fx-background-radius: 0 0 12 12;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- O seu componente Skewb será injetado aqui -->
            </children>
        </StackPane>
    </children>

</fx:root>